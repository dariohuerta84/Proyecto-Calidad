# =====================================================================
#  Web Trouvels360 — configuración de Docker
#  Copia este archivo como .env (levantar.bat lo hace solo si falta).
# =====================================================================

# Dirección de la API Laravel, vista desde el contenedor de la web, SIN /api al final.
#   API en Docker en este mismo equipo → http://host.docker.internal:8000
#   API en la nube                     → https://api.midominio.com
API_URL=http://host.docker.internal:8000

# Puerto del equipo donde se publica la web
PUERTO_WEB=4200
