# =====================================================================
#  API Python (itinerarios) de Trouvels360 — configuración
#  Copia este archivo como .env.fastapi
#  Los valores sirven tal cual para desarrollo local con Docker, junto a api-laravel.
#  En un servidor real cambia la clave y las URLs (ver README, sección "Desplegar en la nube").
# =====================================================================

# ---------------------------------------------------------------- base de datos (solo lectura)
# Es la MISMA base MySQL de api-laravel. Desde este contenedor se llega por el puerto publicado en el equipo:
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=trouvels360
DB_USER=trouvels
DB_PASSWORD=trouvels123
# Alternativa: una URL completa reemplaza a DB_* (p. ej. mysql+pymysql://usuario:clave@host:3306/base)
# DATABASE_URL=

# ---------------------------------------------------------------- seguridad entre las dos APIs
# Solo acepta llamadas firmadas por api-laravel.
# JWT_SECRET debe ser IGUAL a JWT_MS_SECRET de api-laravel/.env
JWT_SECRET=LsRNXkp8PZqz4z_OcAG-TIxzpLToUeWZLgPoHObNEqNyxOr1
JWT_ALGORITHM=HS256
# Debe ser IGUAL a JWT_MS_ISSUER de api-laravel/.env (la URL pública de la API Laravel)
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=fastapi-itinerarios

# ---------------------------------------------------------------- otros
# Orígenes que pueden llamarla desde un navegador (normalmente nadie: la llama Laravel)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000
APP_NAME=Itinerarios Service
APP_VERSION=1.1.0
DEBUG=False
HORAS_DISPONIBLES_POR_DIA=8
