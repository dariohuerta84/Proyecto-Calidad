# El frontend NO usa tokens fijos: la sesión viaja en una cookie HttpOnly (JWT) emitida por Laravel.
# La URL de la API se resuelve con el proxy de Angular:
#   - Docker (docker compose up):  proxy.conf.json        → http://host.docker.internal:8000
#   - Local  (npm run start:local): proxy.conf.local.json → http://localhost:8000
FRONTEND_PORT=4200
