# ==========================================================
# Microservicio de itinerarios — configuración local (Docker)
# Copia este archivo como .env.fastapi
# ==========================================================
# Base de datos: la MISMA MySQL del backend Laravel (contenedor "mysql")
DB_HOST=mysql
DB_PORT=3306
DB_NAME=trouvels360
DB_USER=trouvels
DB_PASSWORD=trouvels123

SERVER_HOST=0.0.0.0
SERVER_RELOAD=False
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000
APP_NAME=Itinerarios Service
APP_VERSION=1.1.0
DEBUG=False

# JWT de servicio: JWT_SECRET debe ser IGUAL a JWT_MS_SECRET del .env de Laravel
JWT_SECRET=cambia-esto-por-el-mismo-valor-que-JWT_MS_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=fastapi-itinerarios

HORAS_DISPONIBLES_POR_DIA=8
