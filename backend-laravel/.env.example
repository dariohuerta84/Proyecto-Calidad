APP_NAME=Trouvels360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Lima
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Base de datos (DB_HOST=mysql es el nombre del contenedor de Docker)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=trouvels360
DB_USERNAME=trouvels
DB_PASSWORD=trouvels123
DB_ROOT_PASSWORD=root123

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# JWT de sesión (php artisan jwt:secret)
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Cookies: en local van por HTTP. En producción con HTTPS usar COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Máximo de intentos de login por minuto (por correo + IP)
LOGIN_RATE_LIMIT=6
# Registros por minuto por IP (elevar solo en entornos de prueba automatizada)
REGISTER_RATE_LIMIT=10

# Microservicio Python de itinerarios (TRV-404)
# JWT_MS_SECRET debe ser IGUAL a JWT_SECRET del .env.fastapi del microservicio
PYTHON_MICROSERVICE_URL=http://itinerarios-api:8001
JWT_MS_SECRET=
JWT_MS_ISSUER=http://localhost:8000

# Unsplash (opcional: búsqueda de imágenes en el panel del proveedor)
UNSPLASH_ACCESS_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
