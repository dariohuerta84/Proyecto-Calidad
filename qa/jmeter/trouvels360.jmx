        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="TC-PERF-003 Verificación: 1x201 y (N-1)x409" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"/>
          <stringProp name="filename"/>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">int n = props.getProperty('hilos.hotel', '20') as int
int ok = (props.get('TC-PERF-003.201') ?: 0) as int
int sin = (props.get('TC-PERF-003.409') ?: 0) as int
SampleResult.setResponseData("hilos=${n} 201=${ok} 409=${sin}", 'UTF-8')
if (n == 0) { SampleResult.setResponseMessage('omitido'); return }
SampleResult.setSuccessful(ok == 1 &amp;&amp; sin == n - 1)
SampleResult.setResponseMessage(ok == 1 &amp;&amp; sin == n - 1 ? 'OK' : "Sobreventa o errores: 201=${ok} 409=${sin}")</stringProp>
        </JSR223Sampler>
        <hashTree/>
