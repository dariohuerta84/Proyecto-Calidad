        <boolProp name="CookieManager.clearEachIteration">false</boolProp>
        <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
      </CookieManager>
      <hashTree/>
      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Copiar cookie XSRF-TOKEN a ${xsrf}" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"/>
        <stringProp name="filename"/>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">// Copia la cookie XSRF-TOKEN a la variable ${xsrf} antes de cada petición (CSRF de doble envío)
def cm = sampler.getCookieManager()
if (cm != null) {
  for (int i = 0; i &lt; cm.getCookieCount(); i++) {
    def c = cm.get(i)
    if (c.getName() == 'XSRF-TOKEN') { vars.put('xsrf', java.net.URLDecoder.decode(c.getValue(), 'UTF-8')) }
  }
}
if (vars.get('xsrf') == null) { vars.put('xsrf', '') }</stringProp>
      </JSR223PreProcessor>
      <hashTree/>
